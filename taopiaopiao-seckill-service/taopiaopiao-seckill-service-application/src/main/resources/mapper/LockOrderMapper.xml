<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.duanyan.taopiaopiao.seckillservice.application.mapper.LockOrderMapper">

    <resultMap id="LockOrderResultMap" type="com.duanyan.taopiaopiao.seckillservice.domain.entity.LockOrder">
        <id property="id" column="id"/>
        <result property="lockId" column="lock_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="requestId" column="request_id"/>
        <result property="userId" column="user_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="eventId" column="event_id"/>
        <result property="seatIds"
                column="seat_ids_json"
                jdbcType="VARCHAR"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result property="seatCount" column="seat_count"/>
        <result property="unitPrice" column="unit_price"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="status" column="status"/>
        <result property="expireTime" column="expire_time"/>
        <result property="failReason" column="fail_reason"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <update id="markOrderCreated">
        UPDATE lock_orders
        SET status = #{toStatus},
            updated_at = NOW()
        WHERE order_no = #{orderNo}
          AND status IN
        <foreach collection="fromStatuses" item="status" open="(" separator="," close=")">
            #{status}
        </foreach>
    </update>

    <update id="updateStatus">
        UPDATE lock_orders
        SET status = #{toStatus},
            fail_reason = #{failReason},
            updated_at = NOW()
        WHERE order_no = #{orderNo}
          AND status IN
        <foreach collection="fromStatuses" item="status" open="(" separator="," close=")">
            #{status}
        </foreach>
    </update>

    <select id="selectRecoverableBatch" resultMap="LockOrderResultMap">
        SELECT id,
               lock_id,
               order_no,
               request_id,
               user_id,
               session_id,
               event_id,
               seat_ids_json,
               seat_count,
               unit_price,
               total_amount,
               status,
               expire_time,
               fail_reason,
               created_at,
               updated_at
        FROM lock_orders
        WHERE status IN
        <foreach collection="statuses" item="status" open="(" separator="," close=")">
            #{status}
        </foreach>
          AND updated_at &lt;= #{olderThan}
        ORDER BY updated_at ASC, id ASC
        LIMIT #{limit}
    </select>

</mapper>
